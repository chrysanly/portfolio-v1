# Test environment.
#
# Laravel loads this file INSTEAD of .env whenever APP_ENV=testing, which
# phpunit.xml sets. That substitution is the point: .env holds the live Neon
# DB_URL, and every connection in config/database.php reads
# `'url' => env('DB_URL')`. ConfigurationUrlParser overrides the driver from the
# URL scheme (postgresql -> pgsql), so a leaked DB_URL beats DB_CONNECTION and
# would point RefreshDatabase at production and migrate:fresh it away.
#
# Because .env is not read here, no production credential can reach the suite.
# Keep it that way: never add a DB_URL or any real host to this file.
#
# The APP_KEY below is a throwaway generated for tests only. It is not used by
# any deployment.

APP_NAME="Portfolio (testing)"
APP_ENV=testing
APP_KEY=base64:tg/N24kdezrLGvuWx0EcuxPrziWmFkL6Y/5HthVTrVM=
APP_DEBUG=true
APP_URL=http://localhost

# In-memory SQLite. DB_URL is deliberately absent, not blank-by-accident.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=stderr

BCRYPT_ROUNDS=4
