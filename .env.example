APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cj_portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#DEBUGGING TOOLS AND SERVICES
APP_STACK=react
ENABLE_SPATIE=false
ENABLE_PDF=false
ENABLE_EXCEL=false
AUTH_MODE=login-register
AUTH_REGISTRATION=true
AUTH_SOCIAL=
AUTH_ALLOWED_DOMAINS=

# Portfolio content admin
# The PIN itself is never stored — only this bcrypt hash. Regenerate with:
#   php artisan portfolio:pin-hash
PORTFOLIO_ADMIN_PIN_HASH=
PORTFOLIO_ADMIN_SESSION_LIFETIME=120
PORTFOLIO_CACHE_TTL=3600

# Absolute path to a PHP 8.3+ binary. Only needed when the `php` first on your
# PATH is an older version — the Vite build shells out to artisan for Wayfinder.
# Windows example: PHP_EXECUTABLE="C:\Users\admin\.config\herd\bin\php.exe"
PHP_EXECUTABLE=

# Fortify account created by AdminUserSeeder (/login, /dashboard, /settings).
# Not the content admin — that one is PIN-only. Leave the password empty locally
# and the seeder falls back to "password" with a warning.
ADMIN_USER_NAME="Chrysanly John C. Roma"
ADMIN_USER_EMAIL="chrys.romao21@gmail.com"
ADMIN_USER_PASSWORD=
