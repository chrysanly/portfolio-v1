/.phpunit.cache
/bootstrap/ssr
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
# resources/js/{actions,routes,wayfinder} are Wayfinder output and would normally
# be generated, not committed. They are tracked because producing them needs PHP
# plus an installed vendor/, which the Vercel build container does not have — and
# Vite imports them, so a PHP-less build cannot succeed without them. Regenerate
# with `php artisan wayfinder:generate` after changing routes or controllers.
/vendor
.DS_Store
.env
# Catches .env.bak, .env.local, .env.production and any other variant, so a
# throwaway copy of a populated .env can never be committed by accident. The
# tracked template is re-allowed below.
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Third-party AI skills installed by `npx skills add` / `npx impeccable install`.
# Reinstallable from the commands in DESIGN_SKILLS_PROMPT.md — 800+ vendored
# files that would otherwise dwarf the project itself in the repository.
/.agents
/.claude/skills
/skills-lock.json

# Local handoff archive, not source.
/cj-portfolio-implementation.zip
